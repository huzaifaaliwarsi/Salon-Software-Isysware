# ── SalonOS frontend environment ───────────────────────────────────────────
# true  → run fully on the in-browser mock (offline demo, no backend needed)
# false → use the Express API (modules not migrated yet fall back to the mock)
VITE_USE_MOCK=false

# API base path. Keep /api/v1 in development (Vite proxies it to the backend).
VITE_API_URL=/api/v1

# Where the dev proxy forwards /api (backend `npm run dev` listens on 5000).
VITE_API_PROXY_TARGET=http://localhost:5000

# ============================================================
# SalonOS Frontend — Production Environment Variables (Vercel)
# ============================================================

# Point to real Express API (disable mock database)
VITE_USE_MOCK=false

# Your Vercel Backend URL + /api/v1 (e.g. https://your-backend.vercel.app/api/v1)
VITE_API_URL=https://your-backend-app.vercel.app/api/v1

# Database (Neon DB Connection Strings)
# DATABASE_URL uses the connection pooler (-pooler)
DATABASE_URL="postgresql://neondb_owner:npg_xOvNkZqa3KH6@ep-dry-block-b5t6irp0-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# DIRECT_URL uses the direct compute instance (no -pooler, needed for Prisma migrations)
DIRECT_URL="postgresql://neondb_owner:npg_xOvNkZqa3KH6@ep-dry-block-b5t6irp0.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Server
PORT=5000
NODE_ENV=production

# JWT Secrets (Random secure strings)
JWT_ACCESS_SECRET=salonos_access_secret_change_in_prod_2026
JWT_REFRESH_SECRET=salonos_refresh_secret_change_in_prod_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (Frontend URL on Vercel or *; *.vercel.app is automatically allowed)

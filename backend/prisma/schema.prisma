// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoiceLifecycle {
  ACTIVE
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillingStatus {
  UNBILLED
  BILLED
}

enum DrawerStatus {
  OPEN
  SETTLEMENT_PENDING
  SETTLED
}

enum MovementDirection {
  IN
  OUT
}

enum DrawerMovementType {
  OPENING_FLOAT
  CASH_SALE
  CASH_TIP
  DUES_COLLECTION
  CASH_REFUND
  EXPENSE
  EXPENSE_REVERSAL
  PAYROLL_PAYOUT
  SALARY_ADVANCE
  COMMISSION_PAYOUT
  TIP_PAYOUT
  SUPPLIER_PAYMENT
  SUPPLIER_REFUND
  TRANSFER_IN
  TRANSFER_OUT
  SETTLEMENT_OUT
  SETTLEMENT_IN
  VARIANCE_ADJUSTMENT
  ADJUSTMENT
  REVERSAL
}

enum AccountMovementType {
  OPENING_FLOAT
  CASH_SALE
  CASH_TIP
  DUES_COLLECTION
  CASH_REFUND
  EXPENSE
  EXPENSE_REVERSAL
  PAYROLL_PAYOUT
  SALARY_ADVANCE
  COMMISSION_PAYOUT
  TIP_PAYOUT
  SUPPLIER_PAYMENT
  SUPPLIER_REFUND
  TRANSFER_IN
  TRANSFER_OUT
  SETTLEMENT_OUT
  SETTLEMENT_IN
  VARIANCE_ADJUSTMENT
  ADJUSTMENT
  REVERSAL
}

enum PaymentAccountType {
  BANK
  EASYPAISA
  JAZZCASH
  OTHER
}

enum TaxTreatment {
  BRANCH_DEFAULT
  SPECIFIC_RULE
  EXEMPT
}

enum ItemType {
  RETAIL_PRODUCT
  SALON_CONSUMABLE
  BOTH
}

enum BatchStatus {
  VALID
  QUARANTINED
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_IN
  SALES_RETURN_IN
  SUPPLIER_REFUND_RESTOCK
  POS_RETURN_IN
  POSITIVE_ADJUSTMENT
  BRANCH_TRANSFER_IN
  POS_SALE_OUT
  SALON_CONSUMPTION_OUT
  SUPPLIER_RETURN_OUT
  EXPIRED_OUT
  DAMAGED_OUT
  INTERNAL_USE_OUT
  PROMOTIONAL_OUT
  NEGATIVE_ADJUSTMENT
  BRANCH_TRANSFER_OUT
}

enum SupplierLedgerType {
  OPENING_BALANCE
  PURCHASE_CREDIT
  PURCHASE_BILL
  SUPPLIER_PAYMENT
  PURCHASE_RETURN
  SUPPLIER_REFUND
  APPROVED_ADJUSTMENT
}

enum PaymentMethod {
  CASH
  ONLINE_ACCOUNT
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ExpenseStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ExpensePaymentMethod {
  CASH
  ONLINE_ACCOUNT
}

enum SettlementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  PAID_LEAVE
  UNPAID_LEAVE
  HOLIDAY
  MISSING_PUNCH
  OFF_DAY
}

enum AttendanceSource {
  MANUAL
  IMPORT
  BIOMETRIC
}

enum PunchType {
  IN
  OUT
}

enum LeaveType {
  PAID
  UNPAID
}

enum LeaveStatus {
  ACTIVE
  CANCELLED
}

enum OvertimeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum CompensationType {
  MONTHLY_SALARY
  DAILY_SALARY
  MONTHLY_PLUS_COMMISSION
  DAILY_PLUS_COMMISSION
  COMMISSION_ONLY
}

enum ProrationMethod {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CommissionRunStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum TipStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum TipAllocationType {
  DIRECT
  POOLED_EQUAL
  POOLED_CUSTOM
}

enum RefundType {
  REFUND
  VOID
}

enum RestockType {
  RESALABLE
  DAMAGED
  NONE
}

enum CommissionEventType {
  EARN
  REVERSAL
}

enum CustomerSource {
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  OTHER
  INSTAGRAM
  FACEBOOK
  TIKTOK
  GOOGLE
  WORD_OF_MOUTH
  INFLUENCER
  RETURNING
